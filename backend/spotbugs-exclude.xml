<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    EI_EXPOSE_REP2: Spring beans are singletons managed by the container.
    Defensive copies in constructor-injected Spring components make no sense.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Class name="com.photokeeper.controller.AuthController"/>
      <Class name="com.photokeeper.controller.LightroomWriteSpikeController"/>
      <Class name="com.photokeeper.controller.PhotoController"/>
      <Class name="com.photokeeper.service.AdobeRateLimiter"/>
      <Class name="com.photokeeper.service.ImsTokenService"/>
      <Class name="com.photokeeper.service.LightroomRateLimitInterceptor"/>
      <Class name="com.photokeeper.service.LightroomService"/>
      <Class name="com.photokeeper.service.LightroomWriteSpikeService"/>
    </Or>
  </Match>
</FindBugsFilter>