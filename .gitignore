# Environment files
/.env
.deploy.env
DS_Store

# Maven build output
backend/target/

# Angular build output bundled into backend by deploy.sh (generated, not committed)
backend/src/main/resources/static/

# Local config with secrets — copy application.properties.template and fill in values
backend/src/main/resources/application.properties

# Local SSL keystore (generated by setup)
backend/src/main/resources/keystore.p12

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java
.idea